# ---------------------------------------------------------------------------
# BharatPredict — example environment file
# Copy to .env.local and fill in real values. All data is mocked today, so the
# app boots fine with this file untouched.
# ---------------------------------------------------------------------------

# --- Crawling / indexing -------------------------------------------------
# Set ALLOW_INDEXING=true only after legal review of the compliance pages.
# Anything other than exactly "true" serves "Disallow: /", an empty sitemap and
# a noindex,nofollow robots meta tag on every page. Read at build time.
ALLOW_INDEXING=false
# Canonical public origin (no trailing slash), used for the sitemap URL.
NEXT_PUBLIC_SITE_URL=

# Default display currency and locale (India-first defaults).
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN

# --- Supabase ---------------------------------------------------------------
# Public (inlined into the browser bundle at BUILD time; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY, runtime variable. The new-style secret key (sb_secret_…), the
# only server key the app uses (D-021). Bypasses RLS: never NEXT_PUBLIC_,
# never logged, imported only from files marked "server-only".
SUPABASE_SECRET_KEY=

# --- Auth (D-019, D-021) ---------------------------------------------------------
# Real Supabase Auth only (no demo). Google always; the 6-digit email code
# only when EMAIL_OTP_ENABLED=true, which needs custom SMTP in the Supabase
# project first. The sheet reads it at BUILD time; the server at runtime.
EMAIL_OTP_ENABLED=false
# Cloudflare Turnstile site key (public, BUILD time). Its secret is configured
# in the Supabase project (Auth > Bot and Abuse Protection), not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SERVER ONLY. Signs the short-lived 18+ consent cookie across the Google
# redirect. 32+ random characters, e.g. `openssl rand -hex 32`.
AUTH_COOKIE_SECRET=
# SERVER ONLY. Shared secret for POST /api/cron (closes expired markets and
# finalizes resolutions). Only needed when the Supabase project has no pg_cron.
# 32+ random characters, e.g. `openssl rand -hex 32`. Empty = route disabled.
CRON_SECRET=
# Optional sign-in attempt limits per 10 minutes (defaults 20 per IP, 5 per email).
AUTH_RATE_LIMIT_PER_IP=
AUTH_RATE_LIMIT_PER_EMAIL=
# Not app variables (set in the Supabase project): Google OAuth client
# id/secret (Auth > Providers > Google), SMTP (Auth > Emails), email templates
# with {{ .Token }} (supabase/templates/*.html).

# --- Payments (not yet wired) ---------------------------------------------
# UPI / payment gateway credentials for INR deposits and withdrawals.
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- Market content translation (offline script only) --------------------
# Used ONLY by `npm run translate:markets` (scripts/), never by the app, the
# build, or tests. Put real values in .env.local, which is gitignored.
# There is deliberately no default model: set it explicitly.
# Provider: Google Gemini only (D-018). Google AI Studio key; model id from
# the Gemini models list, e.g. gemini-3.1-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Data sources (not yet wired) -----------------------------------------
# Live scores, market prices and resolution feeds.
CRICKET_DATA_API_KEY=
MARKET_DATA_API_KEY=

# Set automatically inside the Alloy sandbox.
IS_ALLOY=false

# --- Testing / build (optional) --------------------------------------------
# Next.js build output directory. Leave unset for ".next". The e2e runner uses
# ".next-e2e" so it never overwrites a running dev server's build.
NEXT_DIST_DIR=
# Port for the Playwright production server. Unset = 3000. Use 3100 when a dev
# server already owns 3000 (e.g. the Alloy sandbox).
E2E_PORT=
