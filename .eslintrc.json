{
  "extends": "next/core-web-vitals",
  "ignorePatterns": [
    ".next-e2e/",
    ".next/",
    ".playwright-browsers/",
    "node_modules/",
    "out/",
    "playwright-report/",
    "test-results/"
  ],
  "overrides": [
    {
      "files": [
        "src/app/**/*",
        "src/components/**/*",
        "src/lib/**/*",
        "src/store/**/*",
        "src/i18n/**/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/services/translation/provider/*",
                  "@/services/translation/run",
                  "@/services/translation/store",
                  "**/services/translation/provider/*",
                  "**/services/translation/run",
                  "**/services/translation/store"
                ],
                "message": "The translation service is script/server-only (provider code handles the API key, run/store use the filesystem). App code may import the pure modules services/translation/{types,hash,validate,glossary,prompt} and lib/market-text, and reaches the provider only through the server-only services/admin/machine-translate.ts."
              }
            ]
          }
        ]
      }
    }
  ]
}
