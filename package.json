{
  "name": "bharat-predict",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run build",
    "test:e2e:sandbox": "E2E_PORT=3100 playwright test",
    "translate:markets": "tsx scripts/translate-markets.ts",
    "check:secrets": "bash scripts/check-secrets.sh",
    "validate:translations": "tsx scripts/validate-translations.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "db:test": "supabase test db",
    "check:tokens": "bash scripts/check-tokens.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
